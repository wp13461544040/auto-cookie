# Server
PORT=3000
HTTPS_PORT=3443

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=claude_switcher
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# TLS (optional, leave empty to use HTTP)
TLS_KEY_PATH=
TLS_CERT_PATH=

# Environment: development | production | test
NODE_ENV=development

# Admin Security (IMPORTANT!)
# 管理员用户名
ADMIN_USERNAME=admin

# 管理员密码（SHA256哈希值）- 生产环境必须修改！
# 生成密码哈希: node -e "console.log(require('crypto').createHash('sha256').update('your-password').digest('hex'))"
# 默认密码: admin123 (请务必修改!)
ADMIN_PASSWORD=240be518fabd2724ddb6f04eeb1da5967448d7e831c08c8fa822809f74c720a9

# 管理后台 IP 白名单（可选，逗号分隔）
# 示例: ADMIN_ALLOWED_IPS=127.0.0.1,192.168.1.100
# 留空则不限制 IP（不推荐）
ADMIN_ALLOWED_IPS=127.0.0.1,::1
